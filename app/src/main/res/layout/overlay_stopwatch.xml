<?xml version="1.0" encoding="utf-8"?>
<ScrollView xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="wrap_content"
    android:layout_height="wrap_content"
    android:fillViewport="true"
    android:overScrollMode="never"
    android:scrollbars="none">

    <LinearLayout
        android:id="@+id/panelRoot"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:minWidth="320dp"
        android:background="@drawable/overlay_panel_bg"
        android:elevation="14dp"
        android:orientation="vertical">

        <LinearLayout
            android:id="@+id/fullContent"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical">

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:gravity="center_vertical"
                android:orientation="horizontal">

                <TextView
                    android:id="@+id/tvPageTitle"
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_weight="1"
                    android:text="悬浮秒表"
                    android:textColor="@color/overlay_text"
                    android:textSize="18sp"
                    android:textStyle="bold" />

                <Button
                    android:id="@+id/btnMinimize"
                    android:layout_width="56dp"
                    android:layout_height="32dp"
                    android:background="@drawable/overlay_button_secondary"
                    android:insetTop="0dp"
                    android:insetBottom="0dp"
                    android:minWidth="0dp"
                    android:text="最小化"
                    android:textAllCaps="false"
                    android:textColor="#E5EDFF"
                    android:textSize="10sp" />

                <Button
                    android:id="@+id/btnClose"
                    android:layout_width="56dp"
                    android:layout_height="32dp"
                    android:layout_marginStart="6dp"
                    android:background="@drawable/overlay_button_secondary"
                    android:insetTop="0dp"
                    android:insetBottom="0dp"
                    android:minWidth="0dp"
                    android:text="关闭"
                    android:textAllCaps="false"
                    android:textColor="#FFB4B4"
                    android:textSize="11sp" />
            </LinearLayout>

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="12dp"
                android:orientation="horizontal">

                <Button
                    android:id="@+id/btnTabStopwatch"
                    android:layout_width="0dp"
                    android:layout_height="42dp"
                    android:layout_weight="1"
                    android:background="@drawable/overlay_button_primary"
                    android:insetTop="0dp"
                    android:insetBottom="0dp"
                    android:minWidth="0dp"
                    android:text="悬浮秒表"
                    android:textAllCaps="false"
                    android:textColor="#FFFFFF"
                    android:textSize="12sp" />

                <Button
                    android:id="@+id/btnTabAutoClicker"
                    android:layout_width="0dp"
                    android:layout_height="42dp"
                    android:layout_marginStart="8dp"
                    android:layout_weight="1"
                    android:background="@drawable/overlay_button_secondary"
                    android:insetTop="0dp"
                    android:insetBottom="0dp"
                    android:minWidth="0dp"
                    android:text="自动点击器"
                    android:textAllCaps="false"
                    android:textColor="#E5EDFF"
                    android:textSize="12sp" />

                <Button
                    android:id="@+id/btnTabProfile"
                    android:layout_width="0dp"
                    android:layout_height="42dp"
                    android:layout_marginStart="8dp"
                    android:layout_weight="1"
                    android:background="@drawable/overlay_button_secondary"
                    android:insetTop="0dp"
                    android:insetBottom="0dp"
                    android:minWidth="0dp"
                    android:text="我的"
                    android:textAllCaps="false"
                    android:textColor="#E5EDFF"
                    android:textSize="12sp" />
            </LinearLayout>

            <LinearLayout
                android:id="@+id/pageStopwatch"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="12dp"
                android:orientation="vertical">

                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="时间设置区"
                    android:textColor="@color/overlay_text"
                    android:textSize="16sp"
                    android:textStyle="bold" />

                <TextView
                    android:id="@+id/tvSyncStatus"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="8dp"
                    android:text="同步时间：本机时间"
                    android:textColor="@color/overlay_subtext"
                    android:textSize="12sp" />

                <Button
                    android:id="@+id/btnSyncTime"
                    android:layout_width="match_parent"
                    android:layout_height="38dp"
                    android:layout_marginTop="6dp"
                    android:background="@drawable/overlay_button_primary"
                    android:insetTop="0dp"
                    android:insetBottom="0dp"
                    android:text="同步时间（使用前请同步）"
                    android:textAllCaps="false"
                    android:textColor="#FFFFFF" />

                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="10dp"
                    android:gravity="center_vertical"
                    android:orientation="horizontal">

                    <TextView
                        android:layout_width="0dp"
                        android:layout_height="wrap_content"
                        android:layout_weight="1"
                        android:text="时间偏移"
                        android:textColor="@color/overlay_text"
                        android:textSize="13sp" />

                    <Button
                        android:id="@+id/btnOffsetMinus"
                        android:layout_width="40dp"
                        android:layout_height="34dp"
                        android:background="@drawable/overlay_button_secondary"
                        android:insetTop="0dp"
                        android:insetBottom="0dp"
                        android:minWidth="0dp"
                        android:text="-" />

                    <TextView
                        android:id="@+id/tvOffsetValue"
                        android:layout_width="80dp"
                        android:layout_height="wrap_content"
                        android:gravity="center"
                        android:text="0 秒"
                        android:textColor="#6EA8FF"
                        android:textSize="13sp" />

                    <Button
                        android:id="@+id/btnOffsetPlus"
                        android:layout_width="40dp"
                        android:layout_height="34dp"
                        android:background="@drawable/overlay_button_secondary"
                        android:insetTop="0dp"
                        android:insetBottom="0dp"
                        android:minWidth="0dp"
                        android:text="+" />
                </LinearLayout>

                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="10dp"
                    android:gravity="center_vertical"
                    android:orientation="horizontal">

                    <TextView
                        android:layout_width="0dp"
                        android:layout_height="wrap_content"
                        android:layout_weight="1"
                        android:text="开启声音提醒"
                        android:textColor="@color/overlay_text"
                        android:textSize="13sp" />

                    <Switch
                        android:id="@+id/switchSound"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content" />
                </LinearLayout>

                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="10dp"
                    android:gravity="center_vertical"
                    android:orientation="horizontal">

                    <TextView
                        android:layout_width="0dp"
                        android:layout_height="wrap_content"
                        android:layout_weight="1"
                        android:text="开启倒计时模式"
                        android:textColor="@color/overlay_text"
                        android:textSize="13sp" />

                    <Switch
                        android:id="@+id/switchCountdown"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content" />
                </LinearLayout>

                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="8dp"
                    android:gravity="center_vertical"
                    android:orientation="horizontal">

                    <TextView
                        android:layout_width="0dp"
                        android:layout_height="wrap_content"
                        android:layout_weight="1"
                        android:text="倒计时分钟"
                        android:textColor="@color/overlay_subtext"
                        android:textSize="12sp" />

                    <Button
                        android:id="@+id/btnCountdownMinus"
                        android:layout_width="40dp"
                        android:layout_height="34dp"
                        android:background="@drawable/overlay_button_secondary"
                        android:insetTop="0dp"
                        android:insetBottom="0dp"
                        android:minWidth="0dp"
                        android:text="-" />

                    <TextView
                        android:id="@+id/tvCountdownMinutes"
                        android:layout_width="80dp"
                        android:layout_height="wrap_content"
                        android:gravity="center"
                        android:text="1 分钟"
                        android:textColor="#6EA8FF"
                        android:textSize="13sp" />

                    <Button
                        android:id="@+id/btnCountdownPlus"
                        android:layout_width="40dp"
                        android:layout_height="34dp"
                        android:background="@drawable/overlay_button_secondary"
                        android:insetTop="0dp"
                        android:insetBottom="0dp"
                        android:minWidth="0dp"
                        android:text="+" />
                </LinearLayout>

                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="16dp"
                    android:text="样式设置区"
                    android:textColor="@color/overlay_text"
                    android:textSize="16sp"
                    android:textStyle="bold" />

                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="8dp"
                    android:gravity="center_vertical"
                    android:orientation="horizontal">

                    <TextView
                        android:layout_width="0dp"
                        android:layout_height="wrap_content"
                        android:layout_weight="1"
                        android:text="LED字体"
                        android:textColor="@color/overlay_text"
                        android:textSize="13sp" />

                    <Switch
                        android:id="@+id/switchLed"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content" />
                </LinearLayout>

                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="8dp"
                    android:gravity="center_vertical"
                    android:orientation="horizontal">

                    <TextView
                        android:layout_width="0dp"
                        android:layout_height="wrap_content"
                        android:layout_weight="1"
                        android:text="显示控制按钮"
                        android:textColor="@color/overlay_text"
                        android:textSize="13sp" />

                    <Switch
                        android:id="@+id/switchControls"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content" />
                </LinearLayout>

                <Button
                    android:id="@+id/btnFormat"
                    android:layout_width="match_parent"
                    android:layout_height="38dp"
                    android:layout_marginTop="10dp"
                    android:background="@drawable/overlay_button_secondary"
                    android:insetTop="0dp"
                    android:insetBottom="0dp"
                    android:text="时间格式：HH:mm:ss.S"
                    android:textAllCaps="false"
                    android:textColor="#E5EDFF" />

                <Button
                    android:id="@+id/btnBackgroundColor"
                    android:layout_width="match_parent"
                    android:layout_height="38dp"
                    android:layout_marginTop="8dp"
                    android:background="@drawable/overlay_button_secondary"
                    android:insetTop="0dp"
                    android:insetBottom="0dp"
                    android:text="背景色：深空蓝"
                    android:textAllCaps="false"
                    android:textColor="#E5EDFF" />

                <Button
                    android:id="@+id/btnTextColor"
                    android:layout_width="match_parent"
                    android:layout_height="38dp"
                    android:layout_marginTop="8dp"
                    android:background="@drawable/overlay_button_secondary"
                    android:insetTop="0dp"
                    android:insetBottom="0dp"
                    android:text="字体颜色：冰白"
                    android:textAllCaps="false"
                    android:textColor="#E5EDFF" />

                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="10dp"
                    android:gravity="center_vertical"
                    android:orientation="horizontal">

                    <TextView
                        android:layout_width="0dp"
                        android:layout_height="wrap_content"
                        android:layout_weight="1"
                        android:text="字体大小"
                        android:textColor="@color/overlay_text"
                        android:textSize="13sp" />

                    <Button
                        android:id="@+id/btnFontMinus"
                        android:layout_width="40dp"
                        android:layout_height="34dp"
                        android:background="@drawable/overlay_button_secondary"
                        android:insetTop="0dp"
                        android:insetBottom="0dp"
                        android:minWidth="0dp"
                        android:text="-" />

                    <TextView
                        android:id="@+id/tvFontSizeValue"
                        android:layout_width="80dp"
                        android:layout_height="wrap_content"
                        android:gravity="center"
                        android:text="26"
                        android:textColor="#6EA8FF"
                        android:textSize="13sp" />

                    <Button
                        android:id="@+id/btnFontPlus"
                        android:layout_width="40dp"
                        android:layout_height="34dp"
                        android:background="@drawable/overlay_button_secondary"
                        android:insetTop="0dp"
                        android:insetBottom="0dp"
                        android:minWidth="0dp"
                        android:text="+" />
                </LinearLayout>

                <TextView
                    android:id="@+id/tvTime"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="16dp"
                    android:text="00:00:00.0"
                    android:textColor="@color/overlay_text"
                    android:textSize="26sp"
                    android:textStyle="bold" />

                <TextView
                    android:id="@+id/tvCountdown"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="4dp"
                    android:text="当前模式：普通时间"
                    android:textColor="#6EA8FF"
                    android:textSize="12sp" />

                <TextView
                    android:id="@+id/tvSources"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="6dp"
                    android:text="说明：同步后按当前配置展示"
                    android:textColor="@color/overlay_subtext"
                    android:textSize="11sp" />

                <TextView
                    android:id="@+id/tvAllSources"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="2dp"
                    android:text="提示：背景色、字体色、字号会即时生效"
                    android:textColor="@color/overlay_subtext"
                    android:textSize="10sp" />

                <TextView
                    android:id="@+id/tvMode"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="6dp"
                    android:text="控制按钮：开启"
                    android:textColor="#8FA3C7"
                    android:textSize="11sp" />

                <Button
                    android:id="@+id/btnLaunchOverlay"
                    android:layout_width="match_parent"
                    android:layout_height="42dp"
                    android:layout_marginTop="14dp"
                    android:background="@drawable/overlay_button_primary"
                    android:insetTop="0dp"
                    android:insetBottom="0dp"
                    android:text="开启悬浮秒表"
                    android:textAllCaps="false"
                    android:textColor="#FFFFFF" />
            </LinearLayout>

            <LinearLayout
                android:id="@+id/pageAutoClicker"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="12dp"
                android:orientation="vertical"
                android:visibility="gone">

                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="自动点击器"
                    android:textColor="@color/overlay_text"
                    android:textSize="20sp"
                    android:textStyle="bold" />

                <TextView
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="8dp"
                    android:text="切换至自动点击功能页面（可实现模拟点击操作）"
                    android:textColor="@color/overlay_subtext"
                    android:textSize="13sp" />

                <TextView
                    android:id="@+id/tvAutoClickerHint"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="14dp"
                    android:text="当前为骨架版，后续可继续加入点击坐标、频率和启动/停止逻辑。"
                    android:textColor="#8FA3C7"
                    android:textSize="11sp" />
            </LinearLayout>

            <LinearLayout
                android:id="@+id/pageProfile"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="12dp"
                android:orientation="vertical"
                android:visibility="gone">

                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="我的"
                    android:textColor="@color/overlay_text"
                    android:textSize="20sp"
                    android:textStyle="bold" />

                <TextView
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="8dp"
                    android:text="切换至个人中心页面（包含账号、设置、帮助等入口）"
                    android:textColor="@color/overlay_subtext"
                    android:textSize="13sp" />

                <TextView
                    android:id="@+id/tvProfileHint"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="14dp"
                    android:text="当前为骨架版，后续可继续接入账号信息、设置页和帮助入口。"
                    android:textColor="#8FA3C7"
                    android:textSize="11sp" />
            </LinearLayout>
        </LinearLayout>

        <LinearLayout
            android:id="@+id/minimizedContent"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:gravity="center_vertical"
            android:orientation="horizontal"
            android:visibility="gone">

            <TextView
                android:id="@+id/tvMinimizedTime"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="00:00:00.0"
                android:textColor="@color/overlay_text"
                android:textSize="18sp"
                android:textStyle="bold" />

            <Button
                android:id="@+id/btnRestore"
                android:layout_width="56dp"
                android:layout_height="32dp"
                android:layout_marginStart="8dp"
                android:background="@drawable/overlay_button_secondary"
                android:insetTop="0dp"
                android:insetBottom="0dp"
                android:minWidth="0dp"
                android:text="展开"
                android:textAllCaps="false"
                android:textColor="#E5EDFF"
                android:textSize="11sp" />
        </LinearLayout>

    </LinearLayout>
</ScrollView>
